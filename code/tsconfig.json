{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@campussec/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@campussec/storage": [
        "./packages/storage/src/index.ts"
      ],
      "@campussec/testkit": [
        "./packages/testkit/src/index.ts"
      ],
      "@campussec/core/cases": [
        "./packages/core/cases/index.ts"
      ],
      "@campussec/wazuh-adapter": [
        "./packages/wazuh-adapter/src/index.ts"
      ],
      "@campussec/core/requests/budgets": [
        "./packages/core/requests/budgets.ts"
      ]
    },
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "apps/**/*.ts",
    "apps/**/*.cts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    "packages/*/dist",
    ".local",
    ".cache"
  ]
}
