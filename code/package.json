{
  "name": "campussec",
  "version": "0.2.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "scripts": {
    "check:environment": "node scripts/product/verify-environment.ts",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/product/build.ts",
    "test": "npm run build && node scripts/product/test.ts",
    "check:boundaries": "node scripts/product/check-boundaries.ts",
    "check:spec": "node scripts/product/verify-foundation.ts",
    "check:locks": "node scripts/product/export-npm-lock.ts --check",
    "check:renderer": "node scripts/product/verify-renderer.ts",
    "check": "npm run check:environment && npm run typecheck && npm run build && npm run check:renderer && npm run check:boundaries && npm run check:spec && npm run check:locks && node scripts/product/test.ts",
    "desktop": "npm run build && node scripts/product/start-desktop.ts",
    "check:clean": "node scripts/product/verify-clean.ts",
    "prepare:electron": "node scripts/product/prepare-electron.ts",
    "test:electron": "npm run build && node scripts/product/electron-smoke.ts",
    "test:local": "bun scripts/product/test.ts",
    "check:local": "bun scripts/local/check.ts",
    "check:local:clean": "bun scripts/local/check-clean.ts",
    "test:windows:full": "node scripts/product/test-windows-full.ts"
  },
  "trustedDependencies": [],
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@campussec/testkit": "0.2.0",
    "typescript": "5.9.3",
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "@campussec/core": "0.2.0"
  }
}
