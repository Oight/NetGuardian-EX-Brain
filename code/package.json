{
  "name": "campussec",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15 <25" },
  "workspaces": ["packages/*", "apps/desktop"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/product/build.ts",
    "test": "npm run build && node scripts/product/test.ts",
    "check:boundaries": "node scripts/product/check-boundaries.ts",
    "check:spec": "node scripts/product/verify-foundation.ts",
    "check:locks": "node scripts/product/export-npm-lock.ts --check",
    "check": "npm run typecheck && npm run check:boundaries && npm run check:spec && npm run check:locks && npm test",
    "desktop": "electron dist/apps/desktop/main/bootstrap.js",
    "test:local": "bun scripts/product/test.ts",
    "check:local": "bun scripts/local/check.ts"
  },
  "trustedDependencies": [],
  "dependencies": { "zod": "4.6.7" },
  "devDependencies": { "@campussec/testkit": "0.2.0", "typescript": "5.9.3", "@types/node": "24.19.2", "electron": "45.0.0" }
}
