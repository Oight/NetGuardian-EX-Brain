{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "."
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "apps/**/*.cts"],
  "exclude": [
    "node_modules",
    "dist",
    "dist-test",
    "packages/*/dist",
    "**/tests/**",
    "tests",
    "scripts"
  ]
}
